# ==============================================================================
# EduSmart-AI (CampusCore) - Production Environment Template
# ==============================================================================
# IMPORTANT: This file contains configuration examples and environment templates.
# DO NOT commit real secrets, API keys, or database credentials to version control.
# Copy this file to .env.production on the production host or inject via a secret manager.
# ==============================================================================

# Application & Project Identification
COMPOSE_PROJECT_NAME=campuscore-prod
SPRING_PROFILES_ACTIVE=prod
NODE_ENV=production

# Server Ports (Bound locally behind reverse proxy / ingress controller)
SERVER_PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Domain & Public URL Configurations (HTTPS Strictly Required)
FRONTEND_URL=https://sms.school.edu.lk
NEXT_PUBLIC_API_URL=https://sms.school.edu.lk/api
CORS_ALLOWED_ORIGINS=https://sms.school.edu.lk

# Session Cookie Security (Strictly Enforced in Production)
COOKIE_NAME=sms_session
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=.school.edu.lk

# Cryptographic Authentication Secrets
# Generate using: openssl rand -hex 32
# MUST be at least 32 characters of high-entropy randomness.
JWT_SECRET=replace-with-at-least-32-characters-of-cryptographic-entropy
JWT_EXPIRATION_MS=86400000

# OTP & Authentication Rate Limiting
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_EXPIRY_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT=5
OTP_RATE_LIMIT=5
PASSWORD_RESET_RATE_LIMIT=3

# Database Configuration (MongoDB Atlas Recommended for Production)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://campuscore_app:replace-with-database-user-password@cluster0.abcde.mongodb.net/smsdb_prod?retryWrites=true&w=majority

# Production Mail Delivery (Real SMTP / ESP Relay)
# Example: SendGrid, Amazon SES, or institutional SMTP relay with STARTTLS
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_PROTOCOL=smtp
MAIL_USERNAME=apikey
MAIL_PASSWORD=replace-with-sendgrid-or-ses-smtp-api-key
MAIL_FROM=notifications@sms.school.edu.lk
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true

# Downstream Machine Learning Service (Internal Network Only)
# Never expose the ML service directly to the public internet.
ML_SERVICE_URL=http://ml-service:8000
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# File Upload Policies & Persistent Storage
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_REQUEST_MAX_BYTES=20971520
UPLOAD_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,doc,docx,txt
FEE_CURRENCY=LKR

# Safety Guards - Demo data MUST remain false in production
APP_SEED_DEMO_DATA=false
