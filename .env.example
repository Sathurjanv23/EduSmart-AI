# Copy this file to .env before running Docker Compose. Values are safe examples,
# not production credentials. Use URL-safe MongoDB credentials unless URL-encoded.
COMPOSE_PROJECT_NAME=school-management-system

MONGO_DATABASE=smsdb
MONGO_ROOT_USERNAME=sms_admin
MONGO_ROOT_PASSWORD=replace-with-a-strong-local-password
MONGO_PORT=27017

# Use a cryptographically random value of at least 32 characters outside local demos.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_MS=86400000
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_EXPIRY_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT=10
OTP_RATE_LIMIT=10
PASSWORD_RESET_RATE_LIMIT=5

BACKEND_PORT=8080
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

UPLOAD_MAX_BYTES=10485760
UPLOAD_REQUEST_MAX_BYTES=20971520
UPLOAD_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,doc,docx,txt
FEE_CURRENCY=LKR

# Opt-in synthetic portfolio data. Never enable this seed in production.
APP_SEED_DEMO_DATA=false
DEMO_PASSWORD=DemoOnly!234
LOG_LEVEL=INFO

MAILHOG_UI_PORT=8025
MAIL_FROM=no-reply@campuscore.local
